    \u0442\u0435\u0431\u044F \u043F\u0440\u043E\u0441\u0442\u044F\u0442, \u043A\u043E\u0433\u0434\u0430
    \u0443\u0432\u0438\u0434\u044F\u0442 \u0442\u0432\u043E\u0451 \u0438\u0441\u043A\u0440\u0435\u043D\u043D\u0435\u0435
    \u0440\u0430\u0441\u043A\u0430\u044F\u043D\u0438\u0435! \u0412\u0441\u0451 \u0431\u0443\u0434\u0435\u0442
    \u0445\u043E\u0440\u043E\u0448\u043E! \u0410\u0439\u0434\u0430 \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u044E!"
