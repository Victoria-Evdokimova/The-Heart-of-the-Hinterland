      m_Calls: []
  m_text: "\u042F \u043D\u0430\u0434\u0435\u044E\u0441\u044C, \u0412\u044B \u0436\u0435
    \u043D\u0435 \u0434\u0443\u043C\u0430\u043B\u0438, \n\u0447\u0442\u043E \u0432
    \u043A\u0430\u0436\u0434\u043E\u043C \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u043E\u043C
    \u043F\u0440\u043E\u0445\u043E\u0434\u0435 \n\u0412\u0430\u0441 \u0431\u0443\u0434\u0435\u0442
    \u0436\u0434\u0430\u0442\u044C \u043F\u0440\u0438\u0437? :)\n\nI hope you didn\u2019t
    reckon \nthere\u2019d be a prize waitin\u2019 for ya \nin every secret passage,
    did ya? :)"
