  m_Script: {fileID: 11500000, guid: ca35db4a9ba73a746a609e68811704b6, type: 3}
  m_Name: DialogueNode 2
  m_EditorClassIdentifier: Assembly-CSharp::EndingDialogueNode
  npcTextRU: "\u0422\u044B \u0437\u043D\u0430\u0435\u0448\u044C \u043C\u043E\u0451
    \u0438\u043C\u044F?"
  npcTextEN: You know my name?
  choices:
  - playerTextRU: "\u041A\u043E\u043D\u0435\u0447\u043D\u043E, \u0437\u043D\u0430\u044E.
      \u0423 \u0442\u0435\u0431\u044F \u043E\u0442\u0448\u0438\u0431\u043B\u043E
      \u043F\u0430\u043C\u044F\u0442\u044C, \u0447\u0442\u043E \u043D\u0435 \u043F\u043E\u043C\u043D\u0438\u0448\u044C
      \u043C\u0435\u043D\u044F?"
    playerTextEN: Sure I know it. You lose your memory or somethin', not rememberin'
      me?
    isPositive: 0
    nextNode: {fileID: 11400000, guid: 9b4b5b43b7c19e348b84667468f3b1b9, type: 2}
  - playerTextRU: "\u041A\u0430\u043A \u043D\u0435 \u0437\u043D\u0430\u0442\u044C,
      \u043C\u044B \u0438\u0437 \u043E\u0434\u043D\u043E\u0439 \u0434\u0435\u0440\u0435\u0432\u043D\u0438."
    playerTextEN: How could I not? We're from the same town.
    isPositive: 1
    nextNode: {fileID: 11400000, guid: 0ccdc8a66a0cb81458db5f3f2f5e287b, type: 2}
