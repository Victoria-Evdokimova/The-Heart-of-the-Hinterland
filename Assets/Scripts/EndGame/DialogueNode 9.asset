  m_Name: DialogueNode 9
  m_EditorClassIdentifier: Assembly-CSharp::EndingDialogueNode
  npcTextRU: "\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u043B\u0438 \u0442\u0430\u043A\u043E\u0435?
    \u0421\u043C\u043E\u0433\u0443\u0442 \u043B\u0438 \u043E\u043D\u0438 \u043F\u0440\u043E\u0441\u0442\u0438\u0442\u044C
    \u0438 \u043F\u0440\u0438\u043D\u044F\u0442\u044C \u043C\u0435\u043D\u044F?"
  npcTextEN: Is that possible? Can they forgive and accept me?
  choices:
  - playerTextRU: "\u0417\u0430\u0431\u0443\u0434\u0435\u043C \u0432\u0441\u0451,
      \u0447\u0442\u043E \u0431\u044B\u043B\u043E. \u041B\u044E\u0434\u0438 \u043F\u0440\u043E\u0441\u0442\u044F\u0442
      \u0442\u0435\u0431\u044F. \u041F\u043E\u0439\u0434\u0451\u043C \u0441\u043A\u043E\u0440\u0435\u0435,
      \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u0435 \u0436\u0434\u0443\u0442
      \u043D\u0430\u0441!"
    playerTextEN: Let's forget all that's happened. Folks will forgive you. Come
      on, the town's waitin' for us!
    isPositive: 1
    nextNode: {fileID: 0}
