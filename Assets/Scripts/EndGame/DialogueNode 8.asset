  m_Name: DialogueNode 8
  m_EditorClassIdentifier: Assembly-CSharp::EndingDialogueNode
  npcTextRU: "\u0417\u043B\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u043E
    \u043C\u0435\u043D\u044F... \u0414\u0443\u043C\u0430\u0435\u0448\u044C, \u0443
    \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u0448\u0430\u043D\u0441 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F?"
  npcTextEN: "The evil changed me\u2026 Do you think I got a chance to go back?"
  choices:
  - playerTextRU: "\u0417\u0430\u0432\u0438\u0441\u0438\u0442, \u0438\u0441\u043A\u0440\u0435\u043D\u043D\u0435
      \u043B\u0438 \u0442\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u0448\u044C."
    playerTextEN: Depends on whether you're speakin' true.
    isPositive: 0
    nextNode: {fileID: 11400000, guid: c5bae7e961060f541b31e2d21b94cdca, type: 2}
  - playerTextRU: "\u041D\u0430\u0434\u0435\u044E\u0441\u044C. \u042F \u043F\u0440\u0438\u0448\u0451\u043B,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043C\u043E\u0447\u044C \u0442\u0435\u0431\u0435."
    playerTextEN: I hope so. I came to help you.
    isPositive: 1
    nextNode: {fileID: 11400000, guid: 0c3a0672ed9850749916c3edc48d5807, type: 2}
