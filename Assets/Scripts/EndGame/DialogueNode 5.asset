  m_Script: {fileID: 11500000, guid: ca35db4a9ba73a746a609e68811704b6, type: 3}
  m_Name: DialogueNode 5
  m_EditorClassIdentifier: Assembly-CSharp::EndingDialogueNode
  npcTextRU: "\u041F\u043E\u043C\u043D\u0438\u0442 \u043B\u0438 \u043C\u0435\u043D\u044F
    \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u0435 \u043A\u0442\u043E-\u0442\u043E
    \u0435\u0449\u0451, \u043A\u0440\u043E\u043C\u0435 \u0442\u0435\u0431\u044F?"
  npcTextEN: Does anyone else in town remember me besides you?
  choices:
  - playerTextRU: "\u0421\u0442\u0438\u0432 \u043F\u043E\u043C\u043D\u0438\u0442,
      \u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u043D \u0437\u043E\u043B
      \u043D\u0430 \u0442\u0435\u0431\u044F, \u0438 \u0435\u0441\u0442\u044C \u0437\u0430
      \u0447\u0442\u043E!"
    playerTextEN: "Steve remembers, but he's sore at you \u2013 and with good reason!"
    isPositive: 0
    nextNode: {fileID: 11400000, guid: 6be4f1fd964485f45a94f0b3333359b7, type: 2}
  - playerTextRU: "\u041A\u0430\u043A \u043D\u0435 \u043F\u043E\u043C\u043D\u0438\u0442\u044C!
      \u0421\u0442\u0438\u0432 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043D\u0435
      \u0437\u0430\u0431\u044B\u043B\u0438 \u0442\u0435\u0431\u044F. \u042F \u043E\u0431\u0435\u0449\u0430\u043B
      \u0421\u0442\u0438\u0432\u0443 \u043F\u043E\u043C\u043E\u0447\u044C \u0442\u0435\u0431\u0435,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u044F \u0437\u0434\u0435\u0441\u044C."
    playerTextEN: How could they forget! Steve and the others ain't forgotten you.
      I promised Steve I'd help you, that's why I'm here.
    isPositive: 1
    nextNode: {fileID: 11400000, guid: 6dab45918907fc34496c46c47d0575ca, type: 2}
