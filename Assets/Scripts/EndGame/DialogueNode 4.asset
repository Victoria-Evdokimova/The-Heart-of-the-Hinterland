  m_Name: DialogueNode 4
  m_EditorClassIdentifier: Assembly-CSharp::EndingDialogueNode
  npcTextRU: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u044F \u043F\u0440\u0438\u043F\u043E\u043C\u0438\u043D\u0430\u044E
    \u0442\u0435\u0431\u044F, \u0414\u0436\u0435\u043A."
  npcTextEN: I think I remember you now, Jack.
  choices:
  - playerTextRU: "\u0422\u043E\u0433\u0434\u0430 \u043E\u0442\u0432\u0435\u0447\u0430\u0439,
      \u043D\u0435\u0441\u0447\u0430\u0441\u0442\u043D\u044B\u0439, \u0447\u0442\u043E
      \u0442\u044B \u0442\u0432\u043E\u0440\u0438\u0448\u044C \u0441 \u043D\u0430\u0448\u0435\u0439
      \u0434\u0435\u0440\u0435\u0432\u043D\u0435\u0439?"
    playerTextEN: "Then answer me, you wretch \u2013 what are you doin' to our town?"
    isPositive: 0
    nextNode: {fileID: 11400000, guid: 2f5715a958c1297459625517c0d65607, type: 2}
  - playerTextRU: "\u0427\u0442\u043E \u0441 \u0442\u043E\u0431\u043E\u0439 \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C,
      \u0423\u0438\u043B\u044C\u044F\u043C?"
    playerTextEN: What happened to you, William?
    isPositive: 1
    nextNode: {fileID: 11400000, guid: 6be4f1fd964485f45a94f0b3333359b7, type: 2}
