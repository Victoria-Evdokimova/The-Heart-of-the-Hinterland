  m_Script: {fileID: 11500000, guid: ca35db4a9ba73a746a609e68811704b6, type: 3}
  m_Name: DialogueNode 1
  m_EditorClassIdentifier: Assembly-CSharp::EndingDialogueNode
  npcTextRU: "\u041A\u0430\u043A \u0442\u044B \u043F\u043E\u0441\u043C\u0435\u043B
    \u043D\u0430\u0437\u0432\u0430\u0442\u044C \u043C\u0435\u043D\u044F?"
  npcTextEN: How dare you call me that?
  choices:
  - playerTextRU: "\u041A\u0430\u043A \u0435\u0441\u0442\u044C, \u0442\u0430\u043A
      \u0438 \u043D\u0430\u0437\u0432\u0430\u043B \u2013\u0434\u0443\u0440\u0430\u0447\u043A\u043E\u043C."
    playerTextEN: "I called you what you are \u2013 a fool."
    isPositive: 0
    nextNode: {fileID: 11400000, guid: cd2e8ec9143db7c45bb55b39847d9429, type: 2}
  - playerTextRU: "\u041D\u0435 \u043E\u0431\u0438\u0436\u0430\u0439\u0441\u044F,
      \u044F \u043D\u0435 \u0441\u043E \u0437\u043B\u0430. \u041F\u043E\u043C\u043D\u0438\u0448\u044C,
      \u0432 \u0434\u0435\u0442\u0441\u0442\u0432\u0435 \u0442\u0430\u043A \u043E\u0431\u0437\u044B\u0432\u0430\u043B\u0438\u0441\u044C?"
    playerTextEN: Don't take offense, I meant no harm. Remember how we used to tease
      each other as kids?
    isPositive: 1
    nextNode: {fileID: 11400000, guid: 9b4b5b43b7c19e348b84667468f3b1b9, type: 2}
