  m_Name: DialogueNode 13
  m_EditorClassIdentifier: Assembly-CSharp::EndingDialogueNode
  npcTextRU: "\u0422\u044B \u043F\u0440\u0430\u0432! \u042D\u0442\u043E \u0443\u0436\u0435
    \u0441\u0442\u0430\u043B\u043E \u0447\u0430\u0441\u0442\u044C\u044E \u043C\u0435\u043D\u044F.
    \u041A\u0430\u043A \u044F \u043C\u043E\u0433\u0443 \u0438\u0437\u0431\u0430\u0432\u0438\u0442\u044C\u0441\u044F
    \u043E\u0442 \u0437\u043B\u0430, \u0435\u0441\u043B\u0438 \u044F \u0441\u0430\u043C
    \u2013 \u0437\u043B\u043E?"
  npcTextEN: You're right! It's become a part of me. How can I get rid of evil if
    I am evil myself?
  choices:
  - playerTextRU: "\u0415\u0441\u043B\u0438 \u0442\u044B \u043D\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u0435\u043D
      \u043A \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0443, \u0442\u043E \u0442\u043E\u043B\u044C\u043A\u043E
      \u0447\u0435\u0441\u0442\u043D\u044B\u0439 \u0431\u043E\u0439 \u0440\u0430\u0441\u0441\u0443\u0434\u0438\u0442
      \u043D\u0430\u0441!"
    playerTextEN: If you ain't willin' to talk, then only a fair fight will settle
      this!
    isPositive: 0
